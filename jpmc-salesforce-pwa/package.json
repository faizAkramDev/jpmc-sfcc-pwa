{
  "name": "@jpmorgan/jpmorgan-salesforce-pwa",
  "version": "1.0.0",
  "description": "JP Morgan payment integration for Salesforce Commerce Cloud PWA Kit",
  "keywords": [
    "jpmorgan",
    "salesforce",
    "pwa-kit",
    "checkout",
    "payment",
    "commerce-cloud",
    "sfcc"
  ],
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.js",
  "exports": {
    ".": {
      "require": "./dist/lib/index.js",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./ssr": {
      "require": "./dist/lib/ssr/index.js",
      "import": "./dist/lib/ssr/index.js",
      "default": "./dist/lib/ssr/index.js"
    },
    "./client": {
      "require": "./dist/lib/client/index.js",
      "import": "./dist/lib/client/index.js",
      "default": "./dist/lib/client/index.js"
    },
    "./lib/client": {
      "require": "./dist/lib/client/index.js",
      "import": "./dist/lib/client/index.js",
      "default": "./dist/lib/client/index.js"
    },
    "./lib/ssr": {
      "require": "./dist/lib/ssr/index.js",
      "import": "./dist/lib/ssr/index.js",
      "default": "./dist/lib/ssr/index.js"
    }
  },
  "extensionless": {
    "lookFor": [
      "js",
      "mjs",
      "jsx"
    ]
  },
  "files": [
    "lib",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build-dev": "webpack --mode development",
    "build-prod": "webpack --mode production",
    "build": "npm run clean && npm run build-prod",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint lib/**/*.{js,jsx}",
    "lint:fix": "eslint lib/**/*.{js,jsx} --fix",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kount/kount-web-client-sdk": "^2.0.0",
    "body-parser": "^1.20.3",
    "dotenv": "^16.3.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "node-forge": "^1.4.0",
    "uuid": "^9.0.1 || ^10.0.0 || ^11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "babel-loader": "^9.1.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.0"
  },
  "peerDependencies": {
    "@salesforce/pwa-kit-runtime": ">=3.0.0",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "@salesforce/pwa-kit-runtime": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "license": "MIT",
  "author": "Deloitte Digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deloitte-US/JPMC-PWA.git",
    "directory": "packages/jpmorgan-salesforce-pwa"
  },
  "bugs": {
    "url": "https://github.com/Deloitte-US/JPMC-PWA/issues"
  },
  "homepage": "https://developer.payments.jpmorgan.com"
}
